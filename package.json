{
  "name": "chulseok-roster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src server scripts tests package.json tsconfig.json",
    "build:gas": "tsc --noEmit && node scripts/build.mjs",
    "dev:cloudflare": "npm run build && wrangler dev --local",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:cloudflare": "node --experimental-sqlite --import tsx --test tests/cloudflare/*.test.ts",
    "check": "npm test && npm run test:cloudflare && npm run build"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "signature_pad": "^5.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/google-apps-script": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "wrangler": "^4.151.2"
  }
}
